---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCardPublication from "../components/HorizontalCardPublication.astro";
import { publicationEntries } from "../data/publications";

const baseUrl = import.meta.env.BASE_URL;
const publications = publicationEntries.map((paper) => ({
  ...paper,
  img: paper.img ? `${baseUrl}${paper.img}` : "",
}));

const newsItems = [
  {
    date: "Jul 2026",
    icon: "📄",
    title: "2 New Preprints",
    markerClass: "bg-accent",
    cardClass: "border-accent/40 bg-accent/10",
    cards: [
      {
        title: "PAIR-Bench",
        desc: "Code improvement with progressive, adaptive feedback",
      },
      {
        title: "SpecCoder",
        desc: "Executable intermediate specifications for Code LLMs",
      },
    ],
  },
  {
    date: "Apr 2026",
    icon: "🎉",
    title: "ACL 2026 Acceptance",
    markerClass: "bg-secondary",
    cardClass: "border-secondary/40 bg-secondary/10",
    body: "<b>SpecMind</b> was accepted to the <b>ACL 2026 Main Conference</b> with acceptance rate ~19%.",
  },
  {
    date: "March 2026",
    icon: "🏆",
    title: "ACM SIGSOFT Distinguished Paper Award",
    markerClass: "bg-warning",
    cardClass: "border-warning/40 bg-warning/10",
    body: "<b>SWE-Synth</b> received the <b>ACM SIGSOFT Distinguished Paper Award</b> at ICSE 2026, recognizing it among the top <b>1.5%</b> of accepted papers.",
  },
  {
    date: "March 2026",
    icon: "📄",
    title: "2 New Preprints on Automated Program Repair",
    markerClass: "bg-accent",
    cardClass: "border-accent/40 bg-accent/10",
    cards: [
      {
        title: "EvolRepair",
        desc: "Semantic evolution for LLM-guided APR",
      },
      {
        title: "SpecTune",
        desc: "Specification-guided repair with intermediate behavioral signals",
      },
    ],
  },
  {
    date: "Dec 2025",
    icon: "🎉",
    title: "ICSE 2026 Acceptances",
    markerClass: "bg-success",
    cardClass: "border-success/40 bg-success/10",
    body: "Two papers accepted: <b>TestWeaver</b> and <b>SWE-Synth</b> in ICSE 2026 Research Track (April 12-April 18, 2026, Rio de Janeiro, Brazil).",
  },
  {
    date: "Feb 2025",
    icon: "🎉",
    title: "NAACL 2025 Acceptance",
    markerClass: "bg-info",
    cardClass: "border-info/40 bg-info/10",
    body: "<b>VisualCoder</b> was accepted to Findings of NAACL 2025 (April 29-May 4, 2025, Albuquerque, New Mexico, USA).",
  },
  {
    date: "Jan 2025",
    icon: "🎉",
    title: "FORGE 2025 Acceptance",
    markerClass: "bg-primary",
    cardClass: "border-primary/30 bg-primary/10",
    body: "<b>CodeFlow</b> was accepted to FORGE 2025 (April 27-April 28, Ottawa, Ontario, Canada).",
  },
];
---

<BaseLayout sideBarActiveItemID="home">
    <div class="pb-12 mt-5">
  <!-- ROW: headings + intro (left) and headshot (right) -->
  <div class="flex flex-col md:flex-row md:items-start gap-4">
    <!-- LEFT -->
    <div class="flex-1">
      <div class="text-xl py-1">Hey there 👋</div>
      <div class="text-5xl font-bold">I'm Cuong!</div>
      <div class="text-3xl py-3 font-bold">PhD Student @ The University of Texas at Dallas</div>

      <div class="text-lg">
        <p>
          I am a PhD student in Computer Science at <a class="link" target="_blank" href="https://www.utdallas.edu/">The University of Texas at Dallas</a>, advised by <a class="link" target="_blank" href="https://scholar.google.com/citations?user=l4QhOVoAAAAJ&hl=en">Prof. Tien N. Nguyen</a>. My research lies at the intersection of <b>Software Engineering</b> and <b>AI</b>, with three main directions:
        </p>
        <ol class="my-3 space-y-3">
          <li class="flex items-start gap-3">
            <span class="w-10 shrink-0 text-right font-semibold">(1)</span>
            <span>Applying <b>AI/ML</b> to <b>software engineering tasks</b> at the <b>large-scale repo/project level</b></span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-10 shrink-0 text-right font-semibold">(2)</span>
            <span>Studying how/why <b>Large Language Models understand</b> and <b>reason about program behavior</b></span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-10 shrink-0 text-right font-semibold">(3)</span>
            <span>Building <b>Code World Models</b> that capture <b>dynamic program behavior</b> and support more <b>effective software development workflows</b></span>
          </li>
        </ol>
      </div>
    </div>

    <!-- RIGHT: headshot -->
    <div class="md:ml-2 md:mt-12 md:w-72 lg:w-80 shrink-0 rounded-3xl overflow-hidden bg-base-200 p-2">
    <img
        src={`${baseUrl}cuong.jpeg`}
        alt="Portrait of Cuong"
        class="w-full h-auto max-h-[44rem] object-contain object-top rounded-2xl"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  <div class="mt-3 text-lg">
    <p>
      Previously, I was a full-time Research Resident in the <a class="link" target="_blank" href="https://fpt.com/en/news/fpt-news/fpt-software-ai-center">FPT AI Residency Program</a> from my 3rd year of undergrad, where I worked under the supervision of <a class="link" target="_blank" href="https://scholar.google.com/citations?user=l4QhOVoAAAAJ&hl=en">Prof. Tien N. Nguyen</a> (Full Professor @ UT Dallas) and <a class="link" target="_blank" href="https://bdqnghi.github.io/">Dr. Nghi Bui</a> (Research Scientist @ Google). This selective program provides intensive research training, strong computational support, and world-class mentorship for publishing in top-tier venues.
    </p>
    <p class="mt-2">
      My first-author papers were published in top-tier conferences including <b>ACL'26, ICSE'26, NAACL'25, FORGE'25</b> (see my <a class="link text-blue-600" target="_blank" href="https://scholar.google.com/citations?user=uHHHdN8AAAAJ&hl=en">Google Scholar</a> for more detail). I was also honored to receive the <b>ACM SIGSOFT Distinguished Paper Award</b> at <b>ICSE 2026</b>. </p>
  </div>

  <!-- after flex row: full-width content -->
  <div class="mt-4">
    <div tabindex="0" class="collapse my-2 collapse-arrow rounded-lg border border-current">
      <input type="checkbox" />
      <div class="collapse-title text-lg font-bold">Contact</div>
      <div class="collapse-content">
        <p class="py-2">
          You can email me at:
          <ul>
            <li>• <a class="link" href="mailto:cuong.le@utdallas.edu">cuong.le@utdallas.edu</a> for work-related enquiries, or</li>
            <li>• <a class="link" href="mailto:lechicuongldk@gmail.com">lechicuongldk@gmail.com</a> for other matters.</li>
          </ul>
        </p>
      </div>
    </div>
    <div class="mt-2">
        <a class="btn btn-outline" href={`${import.meta.env.BASE_URL}projects`}> My Projects</a>
        <a class="btn btn-outline" href={`${import.meta.env.BASE_URL}cv`}> My CV</a>
        <a class="btn btn-outline" href="mailto:lechicuongldk@gmail.com" target="_blank"> Email me</a>
      </div>
  </div>
</div>

   <div class="mt-6">
    <div class="mb-4 flex items-end justify-between gap-4">
      <div>
        <div class="text-3xl w-full font-bold mt-2">News</div>
        <p class="mt-1 text-sm opacity-70">Recent research updates and milestones</p>
      </div>
    </div>
    <div class="max-h-[32rem] overflow-y-auto pr-2">
      <div class="space-y-5">
        {newsItems.map((item, index) => (
          <article class="grid grid-cols-[4.5rem_1rem_minmax(0,1fr)] gap-3 sm:grid-cols-[5.5rem_1.25rem_minmax(0,1fr)]">
            <div class="pt-4 text-right">
              <div class="inline-flex rounded-full border border-base-300 bg-base-100 px-2.5 py-1 text-[0.7rem] font-semibold uppercase leading-tight tracking-wide shadow-sm">
                {item.date}
              </div>
            </div>
            <div class="flex flex-col items-center pt-5">
              <div class={`h-3 w-3 rounded-full ring-4 ring-base-100 ${item.markerClass}`}></div>
              {index < newsItems.length - 1 && (
                <div class="mt-2 w-px flex-1 bg-base-300"></div>
              )}
            </div>
            <div class={`rounded-xl border p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md ${item.cardClass}`}>
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-2 text-lg font-semibold leading-snug">
                  <span aria-hidden="true">{item.icon}</span>
                  <span>{item.title}</span>
                </div>
              </div>
              {item.cards ? (
                <div class="mt-3 grid gap-2 sm:grid-cols-2">
                  {item.cards.map((card) => (
                    <div class="rounded-lg bg-base-100/80 p-3">
                      <div class="text-sm font-semibold">{card.title}</div>
                      <div class="text-sm opacity-80">{card.desc}</div>
                    </div>
                  ))}
                </div>
              ) : (
                <p class="mt-2 text-base leading-relaxed" set:html={item.body ?? ""}></p>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10"><a href={`${import.meta.env.BASE_URL}projects`}>Publications</a></div>
  </div>

  {publications.map((paper) => <HorizontalCardPublication {...paper} />)}
</BaseLayout>
